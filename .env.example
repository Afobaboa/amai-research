# Docker Compose reads this file after copying it to .env.
# Production requires your domain, allowed networks, and fresh secrets.
SITE_DOMAIN=lims.example.com
ALLOWED_IPS=127.0.0.1/32 ::1/128
DEBUG=0
DEMO_MODE=0
ALLOWED_HOSTS=lims.example.com
CSRF_TRUSTED_ORIGINS=https://lims.example.com

# Generate SECRET_KEY with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
# Keep single quotes around the hash so Compose does not interpolate "$".
# Generate interactively using the command in README.md.
SITE_PASSWORD_HASH=''

POSTGRES_DB=lims
POSTGRES_USER=lims
# Use a generated hex password, for example: python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=
